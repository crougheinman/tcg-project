# Copy to .env.local and fill in from your free Supabase project
# (Project Settings -> API). PvP needs these; PvAI works without them. They also switch on anonymous match
# statistics (create the table with supabase/migrations/*match_stats.sql; see docs/MATCH_STATS.md).
#
# VITE_ values are copied into the browser bundle, so only PUBLIC values belong here: the project URL and the
# PUBLISHABLE key (sb_publishable_...). Never put a secret / service_role key in a VITE_ variable (the app
# refuses one). The legacy anon key still works in VITE_SUPABASE_ANON_KEY until Supabase retires it.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=   # legacy fallback, only if you have no publishable key
